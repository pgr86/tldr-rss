{
  "functions": {
    "api/feed.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/:feed.rss",
      "destination": "/api/feed?feed=:feed&format=rss"
    },
    {
      "source": "/:feed.html",
      "destination": "/api/feed?feed=:feed&format=html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(icons|splash)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
